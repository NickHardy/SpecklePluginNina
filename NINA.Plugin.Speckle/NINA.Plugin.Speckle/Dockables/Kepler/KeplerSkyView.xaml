<UserControl
    x:Class="NINA.Plugin.Speckle.Dockables.Kepler.KeplerSkyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpfutil="clr-namespace:NINA.WPF.Base.Utility;assembly=NINA.WPF.Base">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/ProfileService.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Brushes.xaml" />
                <wpfutil:SharedResourceDictionary Source="/NINA.WPF.Base;component/Resources/StaticResources/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="KeplerCanvasItem" TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}" />
                <Setter Property="Canvas.Top" Value="{Binding Y}" />
            </Style>

            <DataTemplate x:Key="KeplerCardinal">
                <TextBlock
                    Width="14"
                    Margin="-7,-8,0,0"
                    FontSize="11"
                    Foreground="{StaticResource PrimaryBrush}"
                    Opacity="0.7"
                    Text="{Binding Text}"
                    TextAlignment="Center" />
            </DataTemplate>

            <DataTemplate x:Key="KeplerMarkerTemplate">
                <Canvas x:Name="Root" Visibility="Collapsed">
                    <Ellipse
                        x:Name="Ring"
                        Canvas.Left="-11"
                        Canvas.Top="-11"
                        Width="22"
                        Height="22"
                        Stroke="{StaticResource PrimaryBrush}"
                        StrokeThickness="1"
                        Visibility="Collapsed" />
                    <Path
                        x:Name="Cross"
                        Canvas.Left="-7"
                        Canvas.Top="-7"
                        Width="14"
                        Height="14"
                        Data="M0.5,0 L0.5,0.34 M0.5,0.66 L0.5,1 M0,0.5 L0.34,0.5 M0.66,0.5 L1,0.5 M0.42,0.5 A 0.08,0.08 1 1 1 0.42,0.50001"
                        Opacity="0.8"
                        Stretch="Uniform"
                        Stroke="{StaticResource SecondaryBrush}"
                        StrokeThickness="1" />
                    <Ellipse
                        x:Name="Dot"
                        Canvas.Left="-2.5"
                        Canvas.Top="-2.5"
                        Width="5"
                        Height="5"
                        Fill="{StaticResource SecondaryBrush}"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="NumChip"
                        Canvas.Left="8"
                        Canvas.Top="-18"
                        Padding="3,0"
                        BorderBrush="{StaticResource ButtonForegroundBrush}"
                        BorderThickness="0"
                        CornerRadius="2">
                        <TextBlock
                            x:Name="Num"
                            FontSize="10"
                            Foreground="{StaticResource PrimaryBrush}"
                            Opacity="0.85"
                            Text="{Binding Number}" />
                    </Border>
                    <TextBlock
                        x:Name="Nam"
                        Canvas.Left="9"
                        Canvas.Top="-4"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryBrush}"
                        Opacity="0.85"
                        Text="{Binding Label}"
                        Visibility="Collapsed" />
                </Canvas>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsAboveHorizon}" Value="True">
                        <Setter TargetName="Root" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowName}" Value="True">
                        <Setter TargetName="Nam" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Queued">
                        <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource ButtonForegroundBrush}" />
                        <Setter TargetName="Cross" Property="StrokeThickness" Value="1.5" />
                        <Setter TargetName="Cross" Property="Opacity" Value="1" />
                        <Setter TargetName="NumChip" Property="BorderThickness" Value="1" />
                        <Setter TargetName="Num" Property="Opacity" Value="1" />
                        <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Current">
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Cross" Property="Canvas.Left" Value="-9" />
                        <Setter TargetName="Cross" Property="Canvas.Top" Value="-9" />
                        <Setter TargetName="Cross" Property="Width" Value="18" />
                        <Setter TargetName="Cross" Property="Height" Value="18" />
                        <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                        <Setter TargetName="Cross" Property="StrokeThickness" Value="2" />
                        <Setter TargetName="Cross" Property="Opacity" Value="1" />
                        <Setter TargetName="Num" Property="Opacity" Value="1" />
                        <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Nam" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="Nam" Property="Opacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                        <Setter TargetName="Cross" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Unscheduled">
                        <Setter TargetName="Cross" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource SecondaryBrush}" />
                        <Setter TargetName="Dot" Property="StrokeThickness" Value="1" />
                        <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Excluded">
                        <Setter TargetName="Cross" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource SecondaryBrush}" />
                        <Setter TargetName="Dot" Property="StrokeThickness" Value="1" />
                        <Setter TargetName="Root" Property="Opacity" Value="0.22" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHovered}" Value="True">
                        <Setter TargetName="Root" Property="Opacity" Value="1" />
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Ring" Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="Surface"
        Background="Transparent"
        ClipToBounds="True"
        SizeChanged="OnSurfaceSizeChanged">
        <Path
            Data="{Binding HorizonBlockGeometry}"
            Fill="{StaticResource SecondaryBrush}"
            IsHitTestVisible="False"
            Opacity="0.18" />
        <Path
            Data="{Binding FaintRingGeometry}"
            IsHitTestVisible="False"
            Opacity="0.3"
            Stroke="{StaticResource BorderBrush}"
            StrokeThickness="1" />
        <Path
            Data="{Binding LimitRingGeometry}"
            IsHitTestVisible="False"
            Opacity="0.5"
            Stroke="{StaticResource SecondaryBrush}"
            StrokeDashArray="3 4"
            StrokeThickness="1" />
        <Path
            Data="{Binding HorizonGeometry}"
            IsHitTestVisible="False"
            Opacity="0.85"
            Stroke="{StaticResource BorderBrush}"
            StrokeThickness="1.2" />
        <Path
            Data="{Binding SlitOutlineGeometry}"
            IsHitTestVisible="False"
            Opacity="0.25"
            Stroke="{StaticResource ButtonForegroundBrush}"
            StrokeThickness="1" />
        <Path
            Data="{Binding SlitGeometry}"
            Fill="{StaticResource ButtonForegroundBrush}"
            IsHitTestVisible="False"
            Opacity="0.16" />
        <Path
            x:Name="SlitEdge"
            Data="{Binding SlitGeometry}"
            IsHitTestVisible="False"
            Opacity="0.85"
            Stroke="{StaticResource ButtonForegroundBrush}"
            StrokeThickness="1.5">
            <Path.Style>
                <Style TargetType="Path">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SlitDashed}" Value="True">
                            <Setter Property="StrokeDashArray" Value="3 3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>
        <Path
            Data="{Binding TrackGeometry}"
            IsHitTestVisible="False"
            Opacity="0.4"
            Stroke="{StaticResource PrimaryBrush}"
            StrokeThickness="1" />

        <Canvas IsHitTestVisible="False">
            <Ellipse
                Canvas.Left="{Binding TelescopeX}"
                Canvas.Top="{Binding TelescopeY}"
                Width="12"
                Height="12"
                Margin="-6,-6,0,0"
                Opacity="0.7"
                Stroke="{StaticResource PrimaryBrush}"
                StrokeThickness="1"
                Visibility="{Binding TelescopeVisible, Converter={StaticResource VisibilityConverter}}" />
        </Canvas>

        <ItemsControl
            IsHitTestVisible="False"
            ItemContainerStyle="{StaticResource KeplerCanvasItem}"
            ItemTemplate="{StaticResource KeplerCardinal}"
            ItemsSource="{Binding Cardinals}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl
            IsHitTestVisible="False"
            ItemContainerStyle="{StaticResource KeplerCanvasItem}"
            ItemTemplate="{StaticResource KeplerMarkerTemplate}"
            ItemsSource="{Binding Markers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border
            Margin="8"
            Padding="7,3"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3"
            IsHitTestVisible="False"
            Opacity="0.9"
            Visibility="{Binding HoverVisible, Converter={StaticResource VisibilityConverter}}">
            <TextBlock
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{StaticResource PrimaryBrush}"
                Text="{Binding HoverText}" />
        </Border>

        <TextBlock
            Margin="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="{StaticResource PrimaryBrush}"
            IsHitTestVisible="False"
            Opacity="0.6"
            Text="{Binding ClockText}" />

        <Border
            x:Name="Input"
            Background="Transparent"
            LostMouseCapture="OnInputLostMouseCapture"
            MouseLeave="OnInputMouseLeave"
            MouseMove="OnInputMouseMove"
            MouseWheel="OnInputMouseWheel"
            PreviewMouseLeftButtonDown="OnInputMouseDown"
            PreviewMouseLeftButtonUp="OnInputMouseUp" />
    </Grid>
</UserControl>
